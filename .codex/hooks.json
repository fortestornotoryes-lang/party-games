{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node 'C:\\Users\\Alex\\Desktop\\party-games\\.codex\\hooks\\check-protected-files.js'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "npx tsc --noEmit 2>&1"
          }
        ]
      }
    ]
  }
}
