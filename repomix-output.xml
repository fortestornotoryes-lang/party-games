                         <span className="text-3xl font-black text-white italic">{t.score}</span>
                      </div>
                    ))}
                  </div>
              </div>

               <div className="space-y-3">
                  <button
                    onClick={() => {
                      const resetTeams = teams.map(t => ({ ...t, score: 0 }));
                      setTeams(resetTeams);
                      setCurrentTeamIndex(0);
