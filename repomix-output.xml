              За игру каждый делает ровно {selectedRounds === 1 ? 'одну линию' : `${selectedRounds} линии`} · {selectedTimer > 0 ? `таймер ${selectedTimer}с` : 'без таймера'}
            </p>
          </motion.div>
        )}

      </AnimatePresence>
    </div>
  );
};
